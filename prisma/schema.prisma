generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  tagline   String?
  city      String
  address   String
  phone     String
  email     String?
  pinHash   String?  // zaščita lastniškega območja (4–6 mestni PIN)
  createdAt DateTime @default(now())
  services  Service[]
  hours     WorkingHours[]
}

model WorkingHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  dayOfWeek  Int      // 0 = nedelja ... 6 = sobota
  open       String   // "09:00"
  close      String   // "18:00"

  @@unique([businessId, dayOfWeek])
}

model Service {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id])
  name           String
  description    String?
  durationMin    Int
  priceCents     Int
  peakPriceCents Int
  category       String?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  appointments   Appointment[]
}

model Client {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  notes       String?
  createdAt   DateTime @default(now())
  appointments Appointment[]
}

model Appointment {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  startAt     DateTime
  endAt       DateTime
  priceCents  Int
  status      String   @default("pending") // pending | confirmed | completed | cancelled | no_show
  recurWeeks  Int?     // ponavljajoči termin: stranka prihaja vsake X tednov (npr. 4)
  cancelToken String?  @unique // enkratna koda za odpoved prek povezave (/?cancel=)
  notes       String?
  createdAt   DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String?  // ime stranke (če znano)
  phone     String
  email     String?
  body      String   // kar je stranka napisala
  intent    String   @default("unknown") // booking | price | cenik | availability | unknown
  reply     String?  // osnutek odgovora, ki ga program sestavi
  createdAt DateTime @default(now())
}
